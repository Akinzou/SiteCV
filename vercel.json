{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/pepy/:path*", "destination": "https://pepy.tech/:path*" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/wp-login", "destination": "/wp-login.html" },
    { "source": "/teapot", "destination": "/teapot.html" },
    { "source": "/about", "destination": "/about.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yelon.pro" }],
      "destination": "https://yelon.dev/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yelon.pro" }],
      "destination": "https://yelon.dev/:path*",
      "statusCode": 301
    }
  ]
}
